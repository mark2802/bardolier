{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bardolier.local/schema/status.schema.json",
  "title": "bardolier status output",
  "description": "The app's primary contract. cli-spec.md §7. Once the app ships (Phase 5+), changes to this schema are ADDITIVE ONLY.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ssd",
    "docker",
    "projects",
    "orphaned_volumes"
  ],
  "properties": {
    "ssd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mounted",
        "root"
      ],
      "properties": {
        "mounted": {
          "type": "boolean"
        },
        "root": {
          "type": "string",
          "description": "The default root's path (roots[0]). Present and reportable even when mounted is false. See the top-level `roots` array for every configured root (phase 18)."
        }
      }
    },
    "docker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "orphaned_volumes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/orphanedVolume"
      }
    },
    "roots": {
      "type": "array",
      "description": "Every configured root's readable state. Additive since phase 18.",
      "items": {
        "$ref": "#/$defs/configured_root"
      }
    }
  },
  "$defs": {
    "configured_root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "mounted"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "mounted": { "type": "boolean" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "archetype",
        "state",
        "services",
        "dev_container",
        "dir"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "dir": {
          "type": "string",
          "description": "The project's directory under $SSD_ROOT. Reported rather than composed so the app can reveal it in Finder without knowing the layout (§3).",
          "minLength": 1
        },
        "archetype": {
          "type": "string",
          "enum": [
            "web",
            "ios",
            "android",
            "library"
          ]
        },
        "state": {
          "type": "string",
          "description": "partial = some but not all of the project's containers are up.",
          "enum": [
            "running",
            "stopped",
            "partial"
          ]
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/service"
          }
        },
        "dev_container": {
          "type": [
            "string",
            "null"
          ],
          "description": "Container name, or null when the project is stopped."
        },
        "app_port": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Host port the archetype's dev server is published on (cli-spec.md §9), or null when this project publishes none. Additive since Phase 9.",
          "minimum": 1024,
          "maximum": 65535
        },
        "app_url": {
          "type": [
            "string",
            "null"
          ],
          "description": "Ready-to-open URL for app_port, or null when there is no dev-server port. Reported rather than composed by the caller, for the same reason connection_hint is.",
          "minLength": 1
        },
        "extra_ports": {
          "type": "array",
          "description": "Extra ports declared on this project (cli-spec.md §5.1), sorted by name. Additive since Phase 12.",
          "items": {
            "$ref": "#/$defs/attached_extra_port"
          }
        },
        "root": {
          "type": "string",
          "description": "The configured root's name this project lives under. Additive since phase 18.",
          "minLength": 1
        }
      }
    },
    "attached_extra_port": {
      "type": "object",
      "description": "A declared extra port: the manifest's host port plus the caller's own name. cli-spec.md §5.1, §6 (Ports). Duplicated verbatim across status/port-add/port-remove/port-list; test/contracts.test.ts asserts the copies stay identical.",
      "additionalProperties": false,
      "required": [
        "name",
        "host_port",
        "container_port",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "host_port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "container_port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "display",
        "state",
        "host_port",
        "container_port",
        "connection_hint"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "display": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "running",
            "stopped"
          ]
        },
        "host_port": {
          "type": "integer",
          "description": "Debugging tap on the Mac. NOT what the dev app connects to.",
          "minimum": 1024,
          "maximum": 65535
        },
        "container_port": {
          "type": "integer",
          "description": "Fixed port on the internal Docker network — what the dev app connects to.",
          "minimum": 1,
          "maximum": 65535
        },
        "connection_hint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "orphanedVolume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "size_bytes",
        "size_human",
        "last_project"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "size_human": {
          "type": "string",
          "minLength": 1
        },
        "last_project": {
          "type": [
            "string",
            "null"
          ],
          "description": "Owning project, from the volume's bardolier.project label, or null when it can't be attributed."
        }
      }
    }
  }
}
