{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bardolier.local/schema/new.schema.json",
  "title": "bardolier new output",
  "description": "What `bardolier new` created. cli-spec.md §6 (Projects), §10 (seeded files). Additive changes only once the app ships (Phase 5+).",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "manifest_path", "compose_path", "seeded", "services"],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "archetype", "base_image", "dir", "created"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "archetype": { "type": "string", "enum": ["web", "ios", "android", "library"] },
        "base_image": { "type": "string", "enum": ["bardolier-web", "bardolier-ios", "bardolier-and"] },
        "dir": { "type": "string", "minLength": 1 },
        "created": { "type": "string", "format": "date-time" }
      }
    },
    "manifest_path": { "type": "string", "minLength": 1 },
    "compose_path": { "type": "string", "minLength": 1 },
    "seeded": {
      "type": "array",
      "description": "File names written per §10, in write order.",
      "items": { "type": "string", "minLength": 1 }
    },
    "services": {
      "type": "array",
      "description": "Services attached at creation by --services, sorted by key, each with the host port assigned to it (§5).",
      "items": { "$ref": "#/$defs/attached_service" }
    }
  },
  "$defs": {
    "attached_service": {
      "type": "object",
      "description": "An attached service: the manifest's host port joined with the catalogue's identity. cli-spec.md §4.1, §4.2, §5. This block is duplicated verbatim in new/service-add/service-remove/service-list; test/contracts.test.ts asserts the copies stay identical.",
      "additionalProperties": false,
      "required": ["key", "display", "host_port", "container_port", "connection_hint", "volume"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "display": { "type": "string", "minLength": 1 },
        "host_port": {
          "type": "integer",
          "description": "The debugging tap on the Mac (§5). NOT what the dev app connects to.",
          "minimum": 1024,
          "maximum": 65535
        },
        "container_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "connection_hint": { "type": "string", "minLength": 1 },
        "volume": { "type": "string", "minLength": 1 }
      }
    }
  }
}
