{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bandolier.local/schema/deps-add.schema.json",
  "title": "bandolier deps add output",
  "description": "What `bandolier deps add` declared, and the image it resolves to. cli-spec.md §6 (Deps), §4.2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "added", "extra_packages", "image"],
  "properties": {
    "project": { "type": "string", "minLength": 1 },
    "added": {
      "type": "array",
      "description": "The package(s) just declared.",
      "items": { "type": "string", "minLength": 1 }
    },
    "extra_packages": {
      "type": "array",
      "description": "Every package declared afterwards, sorted.",
      "items": { "type": "string", "minLength": 1 }
    },
    "image": {
      "type": "string",
      "description": "The image this project's dev container now builds/runs from (deps.ts).",
      "minLength": 1
    }
  }
}
