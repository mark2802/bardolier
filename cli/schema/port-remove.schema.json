{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bardolier.local/schema/port-remove.schema.json",
  "title": "bardolier port remove output",
  "description": "What `bardolier port remove` released. cli-spec.md §6 (Ports), §5.1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "removed",
    "extra_ports",
    "compose_path",
    "compose_regenerated"
  ],
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "removed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "host_port"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "host_port": {
          "type": "integer",
          "description": "Released — free for the next allocation (§5.1).",
          "minimum": 1024,
          "maximum": 65535
        }
      }
    },
    "extra_ports": {
      "type": "array",
      "description": "Every extra port still declared, sorted by name.",
      "items": {
        "$ref": "#/$defs/attached_extra_port"
      }
    },
    "compose_path": {
      "type": "string",
      "minLength": 1
    },
    "compose_regenerated": {
      "type": "boolean"
    }
  },
  "$defs": {
    "attached_extra_port": {
      "type": "object",
      "description": "A declared extra port: the manifest's host port plus the caller's own name. cli-spec.md §5.1, §6 (Ports). Duplicated verbatim across status/port-add/port-remove/port-list; test/contracts.test.ts asserts the copies stay identical.",
      "additionalProperties": false,
      "required": [
        "name",
        "host_port",
        "container_port",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "host_port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "container_port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "url": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
